# ==============================================================================
# Incident Response Module (IRM) - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local to configure your cloud Supabase database:
#   copy .env.example .env.local
#
# Obtain these values from your Supabase Dashboard:
# 1. Sign in to https://app.supabase.com
# 2. Select your project (or create a new free project)
# 3. Go to Project Settings -> API
# ==============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon (Public) Key
# IMPORTANT: Use the 'anon' public key here, NEVER the 'service_role' secret key in client code!
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Note: If these variables are not set or left as placeholders, the application
# automatically runs in Local Prototype Mode with an in-memory seed data store,
# ensuring all features, forms, malware analysis, and report generation function smoothly.
